# Marketing SEO Booster v1.0

# Kie API key — https://kie.ai/api-key
KIE_API_KEY=your_kie_api_key_here

# Perplexity API — https://www.perplexity.ai/settings/api (модель sonar-pro)
PERPLEXITY_API_KEY=

# Ahrefs API — https://ahrefs.com/api (Enterprise)
AHREFS_API_KEY=
AHREFS_ENABLED=true
# Понедельник, час UTC (12 = 15:00 МСК летом)
AHREFS_CRON_HOUR=9

# Конкуренты — ежедневный срез (час UTC, 7 = 10:00 МСК)
COMPETITOR_ENABLED=true
COMPETITOR_CRON_HOUR=7

# Dashboard
ENV=development
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8787

# API auth (POST /api/*). Пусто = без auth (только dev)
MONITOR_API_TOKEN=

# Логи: text | json
LOG_LEVEL=INFO
LOG_FORMAT=text

# Быстрые проверки моделей + SEO (минуты, 0 = выкл)
AUTO_CHECK_INTERVAL_MIN=30

# Полный аудит-скан с сохранением в историю
# Вариант 1 — интервал в минутах (0 = выкл)
SCAN_INTERVAL_MIN=60
# Вариант 2 — cron по времени (перекрывает интервал), например 3 раза в день по Москве:
# SCAN_CRON_TIMES=07:00,12:00,21:00
# SCAN_CRON_TIMEZONE=Europe/Moscow
# SCAN_CRON_TIMES=off  — отключить cron из config-профиля

# В full scan не вызывать Kie AI review для SEO (быстрее)
SCAN_SKIP_AI_REVIEW=true

# Минимальный интервал между ручными сканами (секунды, 0 = без лимита)
SCAN_RATE_LIMIT_SEC=300

# Профиль сайта: quickex | altcoinlog | (пусто = config.yaml)
CONFIG_PROFILE=quickex

# ── Alerts (Telegram + webhook) ─────────────────────────────
ALERT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_SCORE_DROP_PCT=10
